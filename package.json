{
  "name": "dsh-bili-fishman",
  "version": "0.1.0",
  "description": "刷B站：她自己在家里刷 B 站的手 —— 打开、成候选、读文字稿、记一笔决定。她自己不再写日记、不写信、不存记忆：那些都在世界插件里（信的工具叫 write_letter）。刷过的记录由世界的 biliBridge 读成记忆，当她写日记的素材。设置页在「设置 → 刷B站」。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "bili-fishman": "./bin/cli.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "bin",
    "prompts",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "lib/client.js"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "bilibili",
    "hands-only",
    "local-first"
  ]
}
